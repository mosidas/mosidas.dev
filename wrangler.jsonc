{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosidas-dev",
  "compatibility_date": "2026-10-12",
  "main": "src/worker.ts",
  // workers.dev からの転送は workers.dev が有効であることを前提にする
  "workers_dev": true,
  "routes": [{ "pattern": "mosidas.dev", "custom_domain": true }],
  // shortcut: アクセス数は Web Analytics(JS を実行するクライアントのみ)、エラーは Workers のメトリクス(例外のみ)で見る, 4xx の件数が要るようになったら Worker で計装する
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // workers.dev の要求もアセットより先に Worker で転送するため
    "run_worker_first": true
  },
  "send_email": [{ "name": "EMAIL" }],
  // Free プランは SQLite バックエンドのみ。Rate Limiting バインディングは本番で 429 を返さなかった(docs/verification.md 7.)
  "durable_objects": { "bindings": [{ "name": "CONTACT_LIMITER", "class_name": "ContactRateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContactRateLimiter"] }],
  // Webhook が届かなくても毎日の更新を反映するため、UTC 21:00(JST 6:00)にビルドを起動する
  "triggers": { "crons": ["0 21 * * *"] },
  "observability": { "enabled": true }
}
