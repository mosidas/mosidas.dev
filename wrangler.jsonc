{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosidas-dev",
  "compatibility_date": "2026-10-12",
  "main": "src/worker.ts",
  // workers.dev からの転送は workers.dev が有効であることを前提にする
  "workers_dev": true,
  "routes": [{ "pattern": "mosidas.dev", "custom_domain": true }],
  // shortcut: アクセス数・エラーのメトリクスなし, R7(アクセス解析)で計装する
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // workers.dev の要求もアセットより先に Worker で転送するため
    "run_worker_first": true
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "observability": { "enabled": true }
}
