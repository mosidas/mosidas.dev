---
import { beaconToken } from '../analytics';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// @types/node を入れていないため、型を付けて process を読む
const { env } = (globalThis as unknown as { process: { env: Record<string, string | undefined> } }).process;
const token = beaconToken(import.meta.env.PUBLIC_WEB_ANALYTICS_TOKEN, Boolean(env.WORKERS_CI));

const links = [
  ['top', '/'],
  ['works', '/works/'],
  ['articles', '/articles/'],
  ['contact', '/contact/'],
];
const section = Astro.url.pathname.split('/')[1];
const currentHref = '/' + (section && section + '/');
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <div class="panel">
      <header>
        <p class="site-title">mosida<span class="slash">/</span></p>
        <nav aria-label="サイト内">
          <ul>
            {
              links.map(([label, href]) => (
                <li>
                  <a href={href} aria-current={href === currentHref ? 'page' : undefined}>
                    <span aria-hidden="true">❯</span> {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <div class="icons">
          <a class="icon" href="https://github.com/mosidas" target="_blank" rel="noopener noreferrer" aria-label="GitHub(新しいタブで開く)">
            <span class="icon-box">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path
                  d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"
                ></path>
              </svg>
            </span>
          </a>
          <a class="icon" href="https://zenn.dev/mosida" target="_blank" rel="noopener noreferrer" aria-label="Zenn(新しいタブで開く)">
            <span class="icon-box">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path
                  d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41zM17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234 0 .468-.117.586-.353z"
                ></path>
              </svg>
            </span>
          </a>
        </div>
        <a class="privacy" href="/privacy/">privacy policy</a>
        <p><small>© 2026 mosida</small></p>
      </footer>
    </div>
    {
      token && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token })}
        ></script>
      )
    }
  </body>
</html>

<style>
  :global(html) {
    /*
      コントラスト比(panel / card / term-bg / hover の順)
      ライト: text 10.04 / 10.30 / 9.87 / 9.11、muted(= term-sub) 6.10 / 6.26 / 5.99 / 5.53、faint 5.11 / 5.24 / 5.02 / 4.63、
        accent-text 5.08 / 5.21 / 4.99 / 4.60、accent2 5.09 / 5.23 / 5.01 / 4.62、反転のナビ: 文字 10.04・❯ 4.65、塗りのボタン 9.87
      ダーク: text 14.53 / 13.68 / 14.75 / 13.68、muted(= term-fg) 10.12 / 9.53 / 10.27 / 9.53、faint 4.93 / 4.64 / 5.00 / 4.64、
        accent 9.98 / 9.39 / 10.13 / 9.39、accent2 11.54 / 10.87 / 11.72 / 10.87、term-sub 7.50 / 7.06 / 7.61 / 7.06、
        反転のナビ: 文字 14.53・❯ 4.65、塗りのボタン 10.27
      入力欄の枠線(--faint、非テキストの 3:1): ライト 5.11 / 5.24、ダーク 4.93 / 4.64
      ダークの装飾の枠線(--line、term-bg / panel): 1.92 / 1.89。#1f2430 では窓の枠が背景に溶けたため上げた
      モックの値は文字の 4.5:1 を満たさないため調整した: ライトの #8A9199 は 3.11、#FA8D3E は 2.29、#A37ACC は 3.29、ダークの #6C7380 は 3.99
    */
    --outer: #f3f4f5;
    --dot: #d3d5d8;
    --panel: #fcfcfc;
    --dot-in: #e7e8e9;
    --card: #ffffff;
    --line: #e7e8e9;
    --hover: #f0f1f2;
    --text: #3b4149;
    --muted: #5c6166;
    --faint: #666d75;
    --accent: #fa8d3e;
    --accent-text: #b44e05;
    --accent2: #8853bd;
    --active-prompt: #bfa3dc;
    --term-bg: #fafafa;
    --term-fg: #3b4149;
    --term-sub: #5c6166;
    --font-mono: 'M PLUS 1 Code', ui-monospace, monospace;
    --font-sans: 'M PLUS 1', system-ui, -apple-system, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
    color-scheme: light dark;
    color: var(--text);
    /* 縦スクロールバーの有無でパネルの位置がずれないよう、溝を両側に常に確保する */
    scrollbar-gutter: stable both-edges;
  }

  @media (prefers-color-scheme: dark) {
    :global(html) {
      --outer: #0b0e14;
      --dot: #1f2430;
      --panel: #0d1017;
      --dot-in: #151a23;
      --card: #131721;
      --line: #3a4253;
      --hover: #131721;
      --text: #e6e1cf;
      --muted: #bfbdb6;
      --faint: #7b8290;
      --accent: #e6b450;
      --accent-text: #e6b450;
      --accent2: #aad94c;
      --active-prompt: #4f6b17;
      --term-bg: #0b0e14;
      --term-fg: #bfbdb6;
      --term-sub: #9da3ad;
    }
  }

  :global(body) {
    box-sizing: border-box;
    display: grid;
    /* 縦は上端に置く。中央だとメインの高さが違うページへ移るたびにナビの位置がずれる */
    place-items: start center;
    min-height: 100vh;
    margin: 0;
    padding: 16px;
    font: 0.875rem/1.9 var(--font-sans);
    background: var(--outer) radial-gradient(var(--dot) 1px, transparent 1px) 0 0 / 16px 16px;
  }

  :global(:focus-visible) {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .panel {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    max-width: 904px;
    border: 1px solid var(--text);
    box-shadow: 6px 6px 0 var(--text);
    background: var(--panel);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 16px;
    border-bottom: 1px solid var(--text);
  }

  .site-title {
    margin: 0;
    padding: 0 8px;
    font: 600 1rem/1.5 var(--font-mono);
  }

  .slash {
    color: var(--accent-text);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 8px;
    font: 0.875rem/1.5 var(--font-mono);
    color: var(--muted);
    text-decoration: none;
  }

  nav a span {
    color: var(--accent-text);
  }

  nav a:hover {
    background: var(--hover);
  }

  nav a[aria-current='page'] {
    color: var(--panel);
    background: var(--text);
  }

  nav a[aria-current='page'] span {
    color: var(--active-prompt);
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: 16px;
    background: radial-gradient(var(--dot-in) 1px, transparent 1px) 0 0 / 16px 16px;
  }

  /* 間隔は main の gap で取る。:where で詳細度を 0 にし、各ページの margin の指定を優先する */
  :global(:where(main > *)) {
    margin-block: 0;
  }

  /* h1 と a は各ページのスロットの中にあり、このコンポーネントのスコープが付かない */
  main :global(h1) {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
  }

  main :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  main :global(a:hover),
  .privacy:hover {
    color: var(--accent-text);
  }

  footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 24px;
    border-top: 1px solid var(--text);
  }

  .icons {
    display: flex;
    margin: 0 -8px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--muted);
  }

  .icon-box {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    box-sizing: border-box;
    border: 1px solid var(--line);
    background: var(--card);
  }

  .icon:hover .icon-box {
    border-color: var(--text);
  }

  .privacy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 0.75rem/1.5 var(--font-mono);
    color: var(--faint);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  footer p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--faint);
  }

  footer small {
    font-size: inherit;
  }

  @media (min-width: 48rem) {
    :global(body) {
      padding: 48px;
    }

    .panel {
      grid-template-columns: 200px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'head main'
        'foot main';
      min-height: 620px;
    }

    header {
      grid-area: head;
      gap: 32px;
      border-bottom: 0;
      border-right: 1px solid var(--text);
    }

    nav ul {
      flex-direction: column;
    }

    main {
      grid-area: main;
      padding: 32px;
    }

    footer {
      grid-area: foot;
      justify-content: flex-end;
      border-top: 0;
      border-right: 1px solid var(--text);
    }
  }
</style>
