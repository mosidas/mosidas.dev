---
import Base from '../../layouts/Base.astro';
import { RESULTS, type ResultName } from '../../contact-messages';

// Cloudflare が公開している、常に検証を通すテスト用のサイトキー
const TEST_SITE_KEY = '1x00000000000000000000AA';

let siteKey: string | undefined = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
if (!siteKey) {
  // 本番のビルド(Workers Builds)でテスト用キーが公開されるのを防ぐ
  // @types/node を入れていないため、型を付けて process を読む
  const { env } = (globalThis as unknown as { process: { env: Record<string, string | undefined> } }).process;
  if (env.WORKERS_CI) throw new Error('PUBLIC_TURNSTILE_SITE_KEY が未設定');
  siteKey = TEST_SITE_KEY;
  console.warn(
    JSON.stringify({
      level: 'warn',
      msg: 'PUBLIC_TURNSTILE_SITE_KEY が未設定のため、テスト用のサイトキーを使う',
      'app.turnstile.site_key': TEST_SITE_KEY,
    }),
  );
}
---

<Base title="お問い合わせ | mosida" description="mosida へのお問い合わせのフォーム。">
  <h1>お問い合わせ</h1>
  {
    (Object.keys(RESULTS) as ResultName[]).map((name) => {
      const { heading, body, missing, requestId, inline } = RESULTS[name];
      return (
        <div class="notice" data-result={name} tabindex="-1" hidden>
          <h2>{heading}</h2>
          {body.map((line) => <p>{line}</p>)}
          {missing && (
            <p>
              {missing}
              <span data-slot="missing" />
            </p>
          )}
          {requestId && (
            <p data-request-id-line>
              {requestId}
              <span data-slot="request-id" />
            </p>
          )}
          {inline && <p>{inline}</p>}
        </div>
      );
    })
  }
  <form method="post" action="/api/contact">
    <div class="field half">
      <label for="name"><span aria-hidden="true">❯</span> name</label>
      <input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
    </div>
    <div class="field half">
      <label for="email"><span aria-hidden="true">❯</span> email</label>
      <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
    </div>
    <div class="field">
      <label for="message"><span aria-hidden="true">❯</span> message</label>
      <textarea id="message" name="message" rows="8" maxlength="5000" required></textarea>
    </div>
    <div class="cf-turnstile" data-sitekey={siteKey} data-language="ja"></div>
    <noscript><p class="note">送信には JavaScript が必要である。ブラウザーで JavaScript を有効にしてほしい。</p></noscript>
    <button type="submit"><span class="idle"><span aria-hidden="true">❯</span> send <span aria-hidden="true">↵</span></span><span class="busy">sending…</span></button>
  </form>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    import { LABELS, missingText, type Field, type ResultName } from '../../contact-messages';

    // shortcut: クライアント側の送信失敗(fetch の例外・JSON でない応答)はログに残さない, 失敗率を知る必要が出たら計装する
    const form = document.querySelector<HTMLFormElement>('form[action="/api/contact"]');
    const NAMES = { sent: true, invalid: true, rejected: true, limited: true, failed: true } satisfies Record<ResultName, true>;

    const show = (name: ResultName, fields: Field[] = [], requestId = '') => {
      for (const el of document.querySelectorAll<HTMLElement>('.notice')) el.hidden = true;
      const notice = document.querySelector<HTMLElement>(`.notice[data-result="${name}"]`);
      if (!notice) return;
      const missing = notice.querySelector('[data-slot="missing"]');
      if (missing) missing.textContent = missingText(fields);
      const id = notice.querySelector('[data-slot="request-id"]');
      if (id) id.textContent = requestId;
      const idLine = notice.querySelector<HTMLElement>('[data-request-id-line]');
      if (idLine) idLine.hidden = requestId === '';
      notice.hidden = false;
      notice.focus();
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      for (const el of document.querySelectorAll<HTMLElement>('.notice')) el.hidden = true;
      for (const el of form.querySelectorAll('[aria-invalid]')) el.removeAttribute('aria-invalid');

      const data = new FormData(form);
      if (!data.get('cf-turnstile-response')) {
        show('rejected');
        return;
      }

      const button = form.querySelector('button');
      if (button) button.disabled = true;
      let result: ResultName = 'failed';
      let fields: Field[] = [];
      let requestId = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new URLSearchParams([...data].map(([k, v]) => [k, String(v)])),
          signal: AbortSignal.timeout(30_000),
        });
        const body: unknown = await res.json();
        // 応答は信頼境界の外から来るため、表示に使う値を許可リストで確かめる
        if (typeof body === 'object' && body !== null) {
          const value = body as Record<string, unknown>;
          if (typeof value.result === 'string' && Object.hasOwn(NAMES, value.result)) result = value.result as ResultName;
          if (Array.isArray(value.fields)) fields = value.fields.filter((f): f is Field => typeof f === 'string' && Object.hasOwn(LABELS, f));
          if (typeof value.requestId === 'string' && /^[\w-]{1,64}$/.test(value.requestId)) requestId = value.requestId;
        }
      } catch {
        // fetch の例外(30 秒の時間切れを含む)と JSON でない本文は、初期値の failed と空の識別番号のまま表示する
      } finally {
        if (button) button.disabled = false;
      }

      if (result === 'sent') {
        form.hidden = true;
        show('sent');
        return;
      }
      (window as Window & { turnstile?: { reset(): void } }).turnstile?.reset();
      for (const f of fields) {
        const field = form.elements.namedItem(f);
        if (field instanceof HTMLElement) field.setAttribute('aria-invalid', 'true');
      }
      show(result, fields, requestId);
    });
  </script>
</Base>

<style>
  form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .notice {
    display: grid;
    gap: 8px;
    padding: 16px;
    border: 1px solid var(--accent-text);
    background: var(--card);
  }

  .notice[data-result='sent'] {
    border-color: var(--line);
  }

  .notice h2 {
    margin: 0;
    font: 600 1rem/1.5 var(--font-sans);
  }

  .notice:not([data-result='sent']) h2 {
    color: var(--accent-text);
  }

  .notice p {
    margin: 0;
  }

  /* display: grid が UA の [hidden] より優先されるため、隠すときの display を明示する */
  .notice[hidden],
  form[hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  label {
    font: 0.75rem/1.5 var(--font-mono);
    color: var(--faint);
  }

  input,
  textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    /* 入力欄の境界は背景に対して 3:1 以上が要るため --faint を使う。16px は iOS の自動拡大を避ける */
    border: 1px solid var(--faint);
    border-radius: 0;
    font: 1rem var(--font-sans);
    color: var(--text);
    background: var(--panel);
  }

  :is(input, textarea):focus {
    border-color: var(--text);
  }

  :is(input, textarea)[aria-invalid='true'] {
    border-color: var(--accent-text);
  }

  textarea {
    line-height: 1.7;
    resize: vertical;
  }

  button {
    justify-self: end;
    min-height: 44px;
    padding: 8px 16px;
    border: 0;
    border-radius: 0;
    font: 0.75rem/1.5 var(--font-mono);
    color: var(--panel);
    background: var(--text);
    cursor: pointer;
  }

  button:hover:not(:disabled) {
    text-decoration: underline;
  }

  button:disabled {
    background: var(--faint);
    cursor: progress;
  }

  button:not(:disabled) .busy,
  button:disabled .idle {
    display: none;
  }

  .note {
    margin: 0;
    color: var(--muted);
  }

  /* Turnstile の iframe は幅 300px 固定のため、枠と padding は幅に余裕がある 48rem 以上だけに付ける */
  @media (min-width: 48rem) {
    form {
      padding: 24px;
      border: 1px solid var(--line);
      background: var(--card);
    }
  }

  @media (min-width: 64rem) {
    form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    form > :not(.half) {
      grid-column: 1 / -1;
    }
  }
</style>
