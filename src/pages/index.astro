---
import { projects } from '../data/projects';
import newsJson from '../data/news.json';
import zennJson from '../data/zenn.json';
import Base from '../layouts/Base.astro';

const news: { id: string; title: string; publishedAt: string; body: string }[] = newsJson;
// scripts/fetch-zenn.mjs でも検証済みだが、表示側でも Zenn 以外へのリンクを出さない
const articles = (zennJson as { title: string; url: string; date: string }[]).filter((a) => a.url.startsWith('https://zenn.dev/'));
const dateFormat = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', dateStyle: 'long' });
---

<Base
  title="mosidas の制作物"
  description="mosidas が個人で作ったソフトウェアの一覧。各制作物の概要と GitHub のリポジトリへのリンクを載せている。"
>
  <h1>mosidas の制作物</h1>
  <p class="lead">mosidas のポートフォリオ。個人で作ったソフトウェアを、概要と GitHub のリポジトリへのリンクとともに並べている。</p>
  <ul>
    {
      projects.map((project) => (
        <li>
          <h2>{project.name}</h2>
          <p>{project.description}</p>
          <ul class="stack" aria-label="使用技術">
            {project.stack.map((tech) => <li>{tech}</li>)}
          </ul>
          <a href={project.url}>{project.url}</a>
        </li>
      ))
    }
  </ul>
  <section class="news" aria-labelledby="news-heading">
    <h2 id="news-heading">お知らせ</h2>
    {
      news.length > 0 ? (
        <ol class="news-list">
          {news.map((item) => (
            <li>
              <time datetime={item.publishedAt}>{dateFormat.format(new Date(item.publishedAt))}</time>
              <h3>{item.title}</h3>
              {/* body は scripts/fetch-news.mjs でサニタイズ済み */}
              <div class="news-body" set:html={item.body} />
            </li>
          ))}
        </ol>
      ) : (
        <p>お知らせはまだない。</p>
      )
    }
  </section>
  <section class="articles" aria-labelledby="articles-heading">
    <h2 id="articles-heading">記事</h2>
    {
      articles.length > 0 ? (
        <ol class="article-list">
          {articles.map((article) => (
            <li>
              <time datetime={article.date}>{dateFormat.format(new Date(article.date))}</time>
              <h3><a href={article.url}>{article.title}</a></h3>
            </li>
          ))}
        </ol>
      ) : (
        <p>記事はまだない。</p>
      )
    }
  </section>
  <p class="contact"><a href="/contact/">問い合わせ</a></p>
</Base>

<style>
  .lead {
    margin: 0 0 48px;
    color: var(--muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }

  h2 {
    margin: 0 0 8px;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }

  li p {
    margin: 0 0 8px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
  }

  .stack li {
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .news,
  .articles {
    margin-top: 48px;
  }

  .news-list,
  .article-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  time {
    display: block;
    margin: 0 0 4px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  h3 {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .news-body :global(:is(p, ul, ol)) {
    margin: 0 0 8px;
  }

  .news-body :global(img) {
    max-width: 100%;
    height: auto;
  }

  .contact {
    margin: 48px 0 0;
  }
</style>
