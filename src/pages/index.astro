---
import newsJson from '../data/news.json';
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';

const news: { id: string; title: string; publishedAt: string; body: string }[] = newsJson;
// sv-SE は YYYY-MM-DD の形で返す
const ymd = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Tokyo' });
---

<Base title="mosida" description="mosida のポートフォリオ。個人で作ったソフトウェア、Zenn の記事、お知らせを載せている。">
  <Terminal>
    <p class="prompt-line" aria-hidden="true"><span class="prompt">❯</span> whoami</p>
    <h1 class="name">mosida</h1>
    <p class="prompt-line" aria-hidden="true"><span class="prompt">❯</span> cat about.txt</p>
    <p class="about">名古屋でソフトウェアエンジニアをしています。</p>
    <p class="about hobby">趣味</p>
    <ul class="hobbies">
      <li>読書: <a href="https://bookmeter.com/users/1496591/books/read" target="_blank" rel="noopener noreferrer">読んだ本<span aria-hidden="true">&nbsp;↗</span><span class="visually-hidden">(新しいタブで開く)</span></a></li>
      <li>カラオケ</li>
      <li>ゴルフ</li>
    </ul>
    <p class="prompt-line" aria-hidden="true"><span class="prompt">❯</span> cat stack.txt</p>
    <ul class="stack" aria-label="使用技術">
      <li>Swift / Go / C# / TypeScript</li>
      <li><a href="https://lapras.com/public/SI8OEWA" target="_blank" rel="noopener noreferrer">LAPRAS<span aria-hidden="true">&nbsp;↗</span><span class="visually-hidden">(新しいタブで開く)</span></a></li>
    </ul>
    <section class="news" aria-labelledby="news-heading">
      <h2 id="news-heading" class="visually-hidden">お知らせ</h2>
      <p class="prompt-line" aria-hidden="true"><span class="prompt">❯</span> tail news.log</p>
      {
        news.length > 0 ? (
          <ol class="log">
            {news.map((item) => (
              <li class="news-row">
                <time datetime={item.publishedAt}>{ymd.format(new Date(item.publishedAt))}</time>
                <div class="news-text">
                  <h3>{item.title}</h3>
                  {/* body は scripts/fetch-news.mjs でサニタイズ済み。空文字も正当な値なので区切りごと出さない */}
                  {item.body && (
                    <>
                      {' — '}
                      <div class="news-body" set:html={item.body} />
                    </>
                  )}
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty">お知らせはまだない。</p>
        )
      }
    </section>
    <p class="prompt-line cursor-line" aria-hidden="true"><span class="prompt">❯</span> <span class="cursor"></span></p>
  </Terminal>
</Base>

<style>
  /* Base の main h1 より詳細度を上げるため class で指定する */
  .name {
    margin: 0 0 12px;
    letter-spacing: -0.03em;
  }

  .about,
  .hobbies {
    max-width: 35rem;
    margin: 0 0 12px;
    font: 0.875rem/1.9 var(--font-sans);
    color: var(--term-sub);
    text-wrap: pretty;
  }

  /* 「趣味」と一覧は続けて読ませるため、間を Terminal の gap だけにする */
  .hobby {
    margin-bottom: 0;
  }

  .hobbies {
    padding: 0;
    list-style: '- ' inside;
  }

  .stack {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  /* woff2 に ↗ が無いため、サンセリフの箇所と同じ退避先で描く */
  .stack span[aria-hidden='true'] {
    font-family: var(--font-sans);
  }

  .news {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
    padding-top: 24px;
  }

  /* 窓の下端へは .news の margin-top: auto で寄せ、カーソルは一覧の直下に付ける(Terminal の .cursor-line の auto を上書き) */
  .news + .cursor-line {
    margin-top: 0;
  }

  .news-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    padding: 4px 0;
  }

  .news-row time {
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .news-text {
    font-family: var(--font-sans);
    color: var(--term-sub);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  h3 {
    display: inline;
    font: inherit;
    font-weight: 600;
    color: var(--term-fg);
  }

  /* 単一段落の本文は「題名 — 本文」の 1 行にし、2 つ目以降のブロックは下に続ける */
  .news-body {
    display: inline;
  }

  .news-body > :global(*) {
    margin: 4px 0 0;
  }

  .news-body > :global(p:first-child) {
    display: inline;
    margin: 0;
  }

  .news-body :global(:is(ul, ol)) {
    padding-left: 1.5em;
  }

  .news-body :global(a)::after {
    /* 1 行目は代替テキストの構文を解釈しないブラウザー向けの退避 */
    content: '\a0↗';
    content: '\a0↗' / '(新しいタブで開く)';
  }

  .news-body :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* 横スクロールを要素の中に閉じ込める。table は block にしないと overflow が効かない */
  .news-body :global(pre),
  .news-body :global(table) {
    display: block;
    overflow-x: auto;
  }

  .empty {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--term-sub);
  }

  @media (min-width: 48rem) {
    .news-row {
      grid-template-columns: 96px minmax(0, 1fr);
    }
  }
</style>
