---
import { projects } from '../data/projects';
import newsJson from '../data/news.json';

const news: { id: string; title: string; publishedAt: string; body: string }[] = newsJson;
const dateFormat = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', dateStyle: 'long' });
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mosidas の制作物</title>
    <meta name="description" content="mosidas が個人で作ったソフトウェアの一覧。各制作物の概要と GitHub のリポジトリへのリンクを載せている。" />
  </head>
  <body>
    <main>
      <h1>mosidas の制作物</h1>
      <p class="lead">mosidas のポートフォリオ。個人で作ったソフトウェアを、概要と GitHub のリポジトリへのリンクとともに並べている。</p>
      <ul>
        {
          projects.map((project) => (
            <li>
              <h2>{project.name}</h2>
              <p>{project.description}</p>
              <ul class="stack" aria-label="使用技術">
                {project.stack.map((tech) => <li>{tech}</li>)}
              </ul>
              <a href={project.url}>{project.url}</a>
            </li>
          ))
        }
      </ul>
      <section class="news" aria-labelledby="news-heading">
        <h2 id="news-heading">お知らせ</h2>
        {
          news.length > 0 ? (
            <ol class="news-list">
              {news.map((item) => (
                <li>
                  <time datetime={item.publishedAt}>{dateFormat.format(new Date(item.publishedAt))}</time>
                  <h3>{item.title}</h3>
                  {/* body は scripts/fetch-news.mjs でサニタイズ済み */}
                  <div class="news-body" set:html={item.body} />
                </li>
              ))}
            </ol>
          ) : (
            <p>お知らせはまだない。</p>
          )
        }
      </section>
    </main>
  </body>
</html>

<style>
  :global(html) {
    /* 白地に対するコントラスト比: 文字 15.5:1、補足 6.5:1、リンク 7.2:1(ダーク: 13.6・8.0・8.4) */
    --text: hsl(220 15% 15%);
    --muted: hsl(220 10% 38%);
    --link: hsl(215 70% 38%);
    --rule: hsl(220 12% 88%);
    --bg: hsl(0 0% 100%);
    color-scheme: light dark;
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
    line-height: 1.7;
    color: var(--text);
    background: var(--bg);
  }

  @media (prefers-color-scheme: dark) {
    :global(html) {
      --text: hsl(220 15% 90%);
      --muted: hsl(220 10% 70%);
      --link: hsl(215 80% 75%);
      --rule: hsl(220 10% 28%);
      --bg: hsl(220 15% 11%);
    }
  }

  :global(body) {
    margin: 0;
  }

  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  h1 {
    margin: 0 0 16px;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .lead {
    margin: 0 0 48px;
    color: var(--muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }

  h2 {
    margin: 0 0 8px;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }

  li p {
    margin: 0 0 8px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
  }

  .stack li {
    padding: 2px 8px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .news {
    margin-top: 48px;
  }

  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  time {
    display: block;
    margin: 0 0 4px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  h3 {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .news-body :global(:is(p, ul, ol)) {
    margin: 0 0 8px;
  }

  .news-body :global(img) {
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--link);
    overflow-wrap: anywhere;
  }

  a:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
</style>
